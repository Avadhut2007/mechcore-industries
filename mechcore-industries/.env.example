# Copy this file to .env for local testing with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables
# Never commit a real .env file — it's already in .gitignore.

# Gmail address that will send the notification email.
SMTP_USER=your-sending-address@gmail.com

# 16-character Gmail "App Password" — NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account).
SMTP_PASS=your-16-char-app-password

# Where quote requests get delivered. Optional — defaults to
# mechcore.ind@gmail.com if not set.
CONTACT_TO=mechcore.ind@gmail.com
